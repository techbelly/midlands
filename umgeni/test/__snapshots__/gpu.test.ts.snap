exports[`pipeline lowering (gpu/lower.ts) > lowers RasterizeParallel to a plan of two passes from IR alone (golden) 1`] = `
"// DecomposeBeziers, one thread per token (generated from Nile IR)
struct Meta { n : u32, major : u32, minor : u32, segBase : u32, segEnd : u32, minBase : u32, minEnd : u32, pad : u32 }
@group(0) @binding(0) var<uniform> META : Meta;
@group(0) @binding(1) var<storage, read> INBUF : array<f32>;
@group(0) @binding(2) var<storage, read_write> OVERFLOW : atomic<u32>;
@group(0) @binding(3) var<storage, read_write> G0 : array<atomic<i32>>;
@group(0) @binding(4) var<storage, read_write> G1 : array<atomic<i32>>;
var<private> S0 : array<f32, 1>;
var<private> F0 : array<f32, 768>;
var<private> sp0 : u32;
fn st0(a0 : f32, a1 : f32, a2 : f32, a3 : f32, a4 : f32, a5 : f32) {
  if (sp0 < 128u) {
    F0[sp0 * 6u + 0u] = a0;
    F0[sp0 * 6u + 1u] = a1;
    F0[sp0 * 6u + 2u] = a2;
    F0[sp0 * 6u + 3u] = a3;
    F0[sp0 * 6u + 4u] = a4;
    F0[sp0 * 6u + 5u] = a5;
    sp0 += 1u;
  } else {
    atomicStore(&OVERFLOW, 1u);
  }
  var T0 : array<f32, 6>;
  var again = false;
  var guard = 0u;
  loop {
    if (guard > 1000000u) { break; }
    guard += 1u;
    if (!again) {
      if (sp0 == 0u) { break; }
      sp0 -= 1u;
      for (var k = 0u; k < 6u; k += 1u) { T0[k] = F0[sp0 * 6u + k]; }
    }
    again = false;
    let v_cse0 = floor(T0[0u]);
    let v_cse1 = floor(T0[4u]);
    let vinside_0 = select(0.0, 1.0, ((v_cse0 == v_cse1) || (ceil(T0[0u]) == ceil(T0[4u]))));
    let v_cse2 = floor(T0[1u]);
    let v_cse3 = floor(T0[5u]);
    let vinside_1 = select(0.0, 1.0, ((v_cse2 == v_cse3) || (ceil(T0[1u]) == ceil(T0[5u]))));
    if (((vinside_0 != 0.0) && (vinside_1 != 0.0))) {
      let vP_0 = select(v_cse1, v_cse0, (v_cse0 < v_cse1));
      let vP_1 = select(v_cse3, v_cse2, (v_cse2 < v_cse3));
      let vw = ((vP_0 + 1.0) - ((T0[4u] + T0[0u]) / 2.0));
      let vh = (T0[5u] - T0[1u]);
      {
        let k0 = i32(floor((vP_1 + 0.5)));
        let k1 = i32(floor((vP_0 + 0.5)));
        if (k0 >= i32(META.segBase) && k0 < i32(META.segEnd) && k1 >= 0 && k1 < i32(META.minor)) {
          let gi = u32(k0) * META.minor + u32(k1);
          atomicAdd(&G0[gi], i32(round((vw * vh) * 65536.0)));
          atomicAdd(&G1[gi], i32(round(vh * 65536.0)));
        }
      }
    } else {
      let v_cse5 = ((T0[0u] + T0[2u]) / 2.0);
      let v_cse7 = ((T0[2u] + T0[4u]) / 2.0);
      let vABBC_0 = ((v_cse5 + v_cse7) / 2.0);
      let v_cse9 = ((T0[1u] + T0[3u]) / 2.0);
      let v_cse11 = ((T0[3u] + T0[5u]) / 2.0);
      let vABBC_1 = ((v_cse9 + v_cse11) / 2.0);
      let vmin_0 = floor(vABBC_0);
      let vmin_1 = floor(vABBC_1);
      let vmax_0 = ceil(vABBC_0);
      let vmax_1 = ceil(vABBC_1);
      let v_cse12 = (vABBC_0 - vmin_0);
      let vnearmin_0 = select(0.0, 1.0, (select(v_cse12, (-v_cse12), (v_cse12 < 0.0)) < 0.1));
      let v_cse13 = (vABBC_1 - vmin_1);
      let vnearmin_1 = select(0.0, 1.0, (select(v_cse13, (-v_cse13), (v_cse13 < 0.0)) < 0.1));
      let v_cse14 = (vABBC_0 - vmax_0);
      let vnearmax_0 = select(0.0, 1.0, (select(v_cse14, (-v_cse14), (v_cse14 < 0.0)) < 0.1));
      let v_cse15 = (vABBC_1 - vmax_1);
      let vnearmax_1 = select(0.0, 1.0, (select(v_cse15, (-v_cse15), (v_cse15 < 0.0)) < 0.1));
      let vM_0 = select(select(vABBC_0, vmax_0, (vnearmax_0 != 0.0)), vmin_0, (vnearmin_0 != 0.0));
      let vM_1 = select(select(vABBC_1, vmax_1, (vnearmax_1 != 0.0)), vmin_1, (vnearmin_1 != 0.0));
      if (sp0 < 128u) {
        F0[sp0 * 6u + 0u] = vM_0;
        F0[sp0 * 6u + 1u] = vM_1;
        F0[sp0 * 6u + 2u] = v_cse7;
        F0[sp0 * 6u + 3u] = v_cse11;
        F0[sp0 * 6u + 4u] = T0[4u];
        F0[sp0 * 6u + 5u] = T0[5u];
        sp0 += 1u;
      } else {
        atomicStore(&OVERFLOW, 1u);
      }
      {
        let next0 = T0[0u];
        let next1 = T0[1u];
        let next2 = v_cse5;
        let next3 = v_cse9;
        let next4 = vM_0;
        let next5 = vM_1;
        T0[0] = next0;
        T0[1] = next1;
        T0[2] = next2;
        T0[3] = next3;
        T0[4] = next4;
        T0[5] = next5;
        again = true;
        continue;
      }
    }
  }
}
@compute @workgroup_size(64)
fn main(@builtin(global_invocation_id) gid : vec3<u32>) {
  let i = gid.x;
  if (i >= META.n) { return; }
  sp0 = 0u;
  st0(INBUF[i * 6u + 0u], INBUF[i * 6u + 1u], INBUF[i * 6u + 2u], INBUF[i * 6u + 3u], INBUF[i * 6u + 4u], INBUF[i * 6u + 5u]);
}
"
`;

exports[`pipeline lowering (gpu/lower.ts) > lowers RasterizeParallel to a plan of two passes from IR alone (golden) 2`] = `
"// WindScan → SpansOf, one thread per segment of the grid (generated from Nile IR)
struct Meta { n : u32, major : u32, minor : u32, segBase : u32, segEnd : u32, minBase : u32, minEnd : u32, pad : u32 }
@group(0) @binding(0) var<uniform> META : Meta;
@group(0) @binding(1) var<storage, read> G0 : array<i32>;
@group(0) @binding(2) var<storage, read> G1 : array<i32>;
@group(0) @binding(3) var<storage, read_write> COV : array<f32>;
var<private> S0 : array<f32, 3>;
var<private> S1 : array<f32, 5>;
fn st1(a0 : f32, a1 : f32, a2 : f32, a3 : f32) {
  var vprev__p_0 = S1[0];
  var vprev__p_1 = S1[1];
  var vprev__p_2 = S1[2];
  var vprev__p_3 = S1[3];
  var von__p = S1[4];
  if ((S1[4] != 0.0)) {
    if ((a1 == S1[1])) {
      let vp_0 = S1[0];
      let vp_1 = S1[1];
      let vp_2 = S1[2];
      let vp_3 = S1[3];
      let vq_0 = a0;
      let v_cse2 = select(vp_2, (-vp_2), (vp_2 < 0.0));
      {
        let px = i32(floor(vp_0));
        let py = i32(floor(vp_1));
        if (px >= 0 && px < i32(META.minor) && py >= 0 && py < i32(META.major)) {
          let ci = u32(py) * META.minor + u32(px);
          COV[ci] = min(COV[ci] + select(1.0, v_cse2, (v_cse2 < 1.0)), 1.0);
        }
      }
      let v_cse5 = select(vp_3, (-vp_3), (vp_3 < 0.0));
      {
        let px = i32(floor((vp_0 + 1.0)));
        let py = i32(floor(vp_1));
        if (px >= 0 && px < i32(META.minor) && py >= 0 && py < i32(META.major)) {
          let ci = u32(py) * META.minor + u32(px);
          COV[ci] = min(COV[ci] + select(1.0, v_cse5, (v_cse5 < 1.0)), 1.0);
        }
      }
    } else {
      let vp_0_u1 = S1[0];
      let vp_1_u1 = S1[1];
      let vp_2_u1 = S1[2];
      let v_cse8 = select(vp_2_u1, (-vp_2_u1), (vp_2_u1 < 0.0));
      {
        let px = i32(floor(vp_0_u1));
        let py = i32(floor(vp_1_u1));
        if (px >= 0 && px < i32(META.minor) && py >= 0 && py < i32(META.major)) {
          let ci = u32(py) * META.minor + u32(px);
          COV[ci] = min(COV[ci] + select(1.0, v_cse8, (v_cse8 < 1.0)), 1.0);
        }
      }
    }
  }
  vprev__p_0 = a0;
  vprev__p_1 = a1;
  vprev__p_2 = a2;
  vprev__p_3 = a3;
  von__p = 1.0;
  S1[0] = vprev__p_0;
  S1[1] = vprev__p_1;
  S1[2] = vprev__p_2;
  S1[3] = vprev__p_3;
  S1[4] = von__p;
}
fn st0(a0 : f32, a1 : f32, a2 : f32, a3 : f32) {
  var vs_H_p = S0[0];
  var vk_H_p = S0[1];
  var von_H_p = S0[2];
  let vH = select(0.0, S0[0], ((S0[2] != 0.0) && (a1 == S0[1])));
  let v_cse0 = (vH + a3);
  st1(a0, a1, (vH + a2), v_cse0);
  vs_H_p = v_cse0;
  vk_H_p = a1;
  von_H_p = 1.0;
  S0[0] = vs_H_p;
  S0[1] = vk_H_p;
  S0[2] = von_H_p;
}
fn fl1() {
  if ((S1[4] != 0.0)) {
    let vp_0_u2 = S1[0];
    let vp_1_u2 = S1[1];
    let vp_2_u2 = S1[2];
    let v_cse2 = select(vp_2_u2, (-vp_2_u2), (vp_2_u2 < 0.0));
    {
      let px = i32(floor(vp_0_u2));
      let py = i32(floor(vp_1_u2));
      if (px >= 0 && px < i32(META.minor) && py >= 0 && py < i32(META.major)) {
        let ci = u32(py) * META.minor + u32(px);
        COV[ci] = min(COV[ci] + select(1.0, v_cse2, (v_cse2 < 1.0)), 1.0);
      }
    }
  }
}
@compute @workgroup_size(64)
fn main(@builtin(global_invocation_id) gid : vec3<u32>) {
  let seg = gid.x + META.segBase;
  if (seg >= META.segEnd) { return; }
  S0[0] = 0.0;
  S0[1] = 0.0;
  S0[2] = 0.0;
  S1[0] = 0.0;
  S1[1] = 0.0;
  S1[2] = 0.0;
  S1[3] = 0.0;
  S1[4] = 0.0;
  for (var m = META.minBase; m < META.minEnd; m += 1u) {
    let gi = seg * META.minor + m;
    st0(f32(m) + 0.5, f32(seg) + 0.5, f32(G0[gi]) / 65536.0, f32(G1[gi]) / 65536.0);
  }
  fl1();
}
"
`;
