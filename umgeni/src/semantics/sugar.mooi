-- Extended Nile's scans and windows are sugar: rewritten here into core
-- Nile (state, primed updates, ifs), returning the kernel and what the
-- sugar declared (a parallel backend lowers by the declaration).

desugar k fieldsOf
  | any (\f -> f.cons != null) k.forAlls = windows k
  | otherwise                            = scanIn k (find (\f -> f.scan != null) k.forAlls) fieldsOf
scanIn k null fieldsOf = {kernel: k, declared: {}}
scanIn k arm fieldsOf  = scan k arm fieldsOf

-- ∀ pat with H = ⊕[e] by @key  ⇒
--     s#H = identity, k#H = 0, on#H = 0
--     ∀ pat:  H = { s#H if on#H ∧ key = k#H, identity };  …body…;
--             s#H' = H ⊕ e;  k#H' = key;  on#H' = 1
scan k arm fieldsOf =
  let sc = arm.scan,
      id = must (identityOf sc.op) ("'" ++ sc.op ++ "[…]' has no known identity; scan operators must (so far) be one of + ×"),
      s = "s#" ++ sc.name, last = "k#" ++ sc.name, on = "on#" ++ sc.name,
      pk = keyOf k arm.pattern sc.key fieldsOf,
      body = [decl sc.name cond{cases: [{value: v s, cond: bin "∧" (v on) (bin "=" pk.key (v last))}], otherwise: lit id}]
             ++ arm.body ++ [update s (bin sc.op (v sc.name) sc.expr), update last pk.key, update on (lit 1)]
  in {kernel: {...k, prologue: k.prologue ++ [decl s (lit id), decl last (lit 0), decl on (lit 0)],
               forAlls: map (\f -> if f == arm then {...f, pattern: pk.pattern, scan: null, body: body} else f) k.forAlls},
      declared: {scan: {key: sc.key, op: sc.op, identity: id}}}

identityOf "+" = 0
identityOf "×" = 1
identityOf _   = null

-- ∀ p ∷ q [by @key] and ∀ p ∷ ∅  ⇒
--     prev# = 0 : Input, on# = 0
--     ∀ in#:  if on#: (if in#.key = prev#.key: p = prev#, q = in#, …pair…
--                      else: p = prev#, …end…);  prev#' = in#;  on#' = 1
--     flush:  if on#: p = prev#, …end…
windows k
  | any (\f -> f.cons == null) k.forAlls = fail ("'" ++ k.name ++ "' mixes plain and windowed ∀ arms")
  | otherwise =
      windowsOf k (find (\f -> f.cons != null && f.cons != "end") k.forAlls) (find (\f -> f.cons == "end") k.forAlls)
windowsOf k pair end
  | pair == null || length k.forAlls > (if end == null then 1 else 2) =
      failIn k "windowed kernels take one 'p ∷ q' arm and at most one 'p ∷ ∅' arm"
  | any (\f -> f.scan != null) k.forAlls = failIn k "with-clauses on windowed arms are not yet supported"
  | k.type.kind != "streamType"           = failIn k "windows need an explicit stream type"
  | otherwise =
      let input = v "in#", prev = v "prev#",
          pairArm = bind pair.pattern prev ++ bind pair.cons input ++ pair.body,
          onEnd = if end == null then [] else bind end.pattern prev ++ end.body,
          step = if pair.consKey == null then pairArm
                 else [when (bin "=" (fieldOf input pair.consKey) (fieldOf prev pair.consKey)) pairArm onEnd]
      in {kernel: {...k, prologue: k.prologue ++ [typedDecl "prev#" (lit 0) k.type.input, decl "on#" (lit 0)],
                   forAlls: [forAll{pattern: varPat{name: "in#"}, cons: null, consKey: null, scan: null,
                                    body: [when (v "on#") step null, update "prev#" input, update "on#" (lit 1)]}],
                   flush: (if end == null then [] else [when (v "on#") onEnd null]) ++ k.flush},
          declared: {window: {key: pair.consKey}}}

-- The input's key field under the arm's pattern: a field of a whole-token
-- name, or the element a tuple pattern binds (a wildcard gets a name).
keyOf k p@varPat{name} key fieldsOf = {pattern: p, key: fieldOf (v name) key}
keyOf k p key fieldsOf
  | k.type.kind != "streamType" = failIn k "a keyed scan needs an explicit stream type"
  | p.kind != "tuplePat"        = failIn k ("cannot find '@" ++ key ++ "' under a wildcard pattern")
  | otherwise                   = keyAt k p key (indexOf key (fieldsOf k.type.input))
keyAt k p key i
  | i == null || i >= length p.elements = failIn k ("'@" ++ key ++ "' is not a top-level field of the input")
  | otherwise                           = keyIs k p key i (at p.elements i)
keyIs k p key i varPat{name}  = {pattern: p, key: v name}
keyIs k p key i tuplePat{}    = failIn k ("scan key '@" ++ key ++ "' must be a Real field")
keyIs k p key i _             = {pattern: {...p, elements: mapi (\e j -> if j == i then varPat{name: "key#" ++ key} else e) p.elements},
                                 key: v ("key#" ++ key)}

-- Core Nile, built.
v n             = var{name: n}
lit n           = num{value: n}
bin op a b      = binOp{op: op, left: a, right: b}
fieldOf e f     = field{object: e, field: f}
decl n e        = decl{name: n, type: null, value: e}
typedDecl n e t = decl{name: n, type: t, value: e}
update n e      = assign{name: n, value: e}
when c t f      = if{cond: c, then: t, else: f}
bind varPat{name} e  = [decl name e]
bind p@tuplePat{} e  = [patAssign{pattern: p, value: e}]
bind p e             = []

-- An error in kernel k, named.
failIn k msg = fail ("'" ++ k.name ++ "': " ++ msg)
