-- The meaning of a pipeline: its stages, each over the stream the one
-- before it leaves. A stream between stages is its shape, and whether its
-- order is known: GroupBy promises key order only, so after it, until a
-- ReduceBy has made each key one token, only a stage that does not read
-- tokens in arrival order may follow (a ReduceBy by commutative operators).
-- That is what licenses a parallel back end to accumulate in any order.
--
-- A stage is a kernel, a builtin that needs the whole stream (SortBy,
-- Reverse, DupCat, DupZip), a process-typed parameter (spliced in from the
-- closure its argument made), or a template (a process with process-typed
-- parameters, instantiated here: no process is a value at run time).
--
-- The host supplies: P.field (a field's offset and shape in a shape),
-- P.realField (the offset of a field that must be a Real),
-- P.expr (an argument, staged), P.type, P.stream (a process's stream types,
-- or null; P.known says whether the name exists), P.template (a template's
-- parameters and the pipeline that is its body, or null), P.isStream (a type names a process type), and the
-- environments: empty, bind, lookupProc, bindProc. Values come from
-- values.mooi, loaded with this file.

-- A context: the pipeline being defined (for messages), the values its
-- parameters are bound to, and its process-typed parameters' closures.
pipeline who elems ρ procs input = stages (context who ρ procs) elems {shape: input, unordered: false}
context who env procs = {who: who, env: env, procs: procs}

stages c [] s             = {stages: [], output: s.shape}
stages c [el, ...rest] s  = let r = stage c el s, more = stages c rest r.stream
                            in {stages: r.stages ++ more.stages, output: more.output}

stage c identityPipeline{} s   = {stages: [{k: "identity"}], stream: s}
stage c groupBy{keys, stable} s =
  {stages: [{k: "groupBy", keyIndexes: map (\k -> P.realField s.shape k "GroupBy key") keys, stable: stable}],
   stream: {shape: s.shape, unordered: not stable}}
stage c reduceBy{keys, fields} s =
  {stages: [{k: "reduceBy", width: width s.shape,
             keyIndexes: map (\k -> (P.field s.shape k).offset) keys, fields: map (reduction c s) fields}],
   stream: {shape: s.shape, unordered: false}}
stage c stageRef{name} s        = named c name [] s
stage c stageApp{name, args} s  = named c name args s

-- A reduced field: combined by its operator, a scalar expression over the
-- two values being combined (#ra, #rb): locals the back end names.
local n = scalar {k: "local", name: n}
reduction c s f
  | s.unordered && not (commutative f.op) =
      fail (fmt "ReduceBy in '%' uses '%', not known to be commutative, on unordered groups; use 'GroupBy stable (…)'" [c.who, f.op])
  | otherwise =
      let operands = bind (bind empty "#ra" (local "#ra")) "#rb" (local "#rb")
      in combined s f (P.expr binOp{op: f.op, left: var{name: "#ra"}, right: var{name: "#rb"}} operands)
combined s f scalar{expr} = {index: P.realField s.shape f.name "ReduceBy field", op: expr}
combined s f _            = fail (fmt "ReduceBy operator '%' must combine Reals" [f.op])

commutative op = member op ["+", "×", "◁", "▷", "∧", "∨"]

-- A stage that reads tokens in arrival order may not follow unordered groups.
ordered c what s
  | s.unordered = fail (fmt "'%' in '%' consumes tokens in arrival order after a non-stable GroupBy; use 'GroupBy stable (…)' or reduce the groups first" [what, c.who])
  | otherwise   = unit

-- A named stage: a builtin that needs the whole stream, a process-typed
-- parameter, a template, or a plain process. Every one but SortBy reads
-- tokens in arrival order, so each checks `ordered` before building its
-- stage (`;` runs the check, which fails or passes, then the right side).
named c "SortBy" [offset{field}] s = {stages: [{k: "sortBy", keyIndexes: [(P.field s.shape field).offset]}], stream: s}
named c "SortBy" args s  = fail (fmt "SortBy in '%' expects a single @field key" [c.who])
named c "Reverse" args s = ordered c "Reverse" s; {stages: [{k: "reverse"}], stream: s}
named c "DupCat" args s  = ordered c "DupCat" s; dupCat c (branches c "DupCat" args s)
named c "DupZip" args s  = ordered c "DupZip" s; dupZip (branches c "DupZip" args s)
named c name args s
  | lookupProc c.procs name != null = parameter c name args s
  | P.template name != null         = ordered c name s; spliced (instantiate c (P.template name) args s)
  | not (P.known name)              = fail (fmt "pipeline '%' references unknown process '%'" [c.who, name])
  | P.stream name == null           = fail (fmt "pipeline stage '%' is not a plain stream" [name])
  | otherwise                       = ordered c name s;
                                      {stages: [{k: "stage", name: name, args: map (argument c name) args}],
                                       stream: {shape: (P.stream name).output, unordered: false}}

-- DupCat: both branches' output, the first's then the second's, so they
-- must agree. DupZip: the two outputs paired.
dupCat c [a, b]
  | width a.output != width b.output = fail (fmt "DupCat in '%' takes two pipelines with the same output type" [c.who])
  | otherwise                        = {stages: [{k: "dupCat", branches: [a.stages, b.stages]}],
                                        stream: {shape: a.output, unordered: false}}
dupZip [a, b]   = {stages: [{k: "dupZip", branches: [a.stages, b.stages]}],
                   stream: {shape: pairOf a.output b.output, unordered: false}}
pairOf x y      = {k: "record", name: null, fields: [{name: null, shape: x}, {name: null, shape: y}]}

-- A process-typed parameter: its argument's pipeline, spliced in, in the
-- scope the argument was written in.
parameter c name [] s   = ordered c name s;
                          (let cl = lookupProc c.procs name
                           in spliced (stages (context c.who cl.env cl.procs) cl.elems s))
parameter c name args s = fail (fmt "process parameter '%' takes no arguments" [name])

argument c name pipelineArg{} = higherOrder c name
argument c name stageApp{}    = higherOrder c name
argument c name a             = leaves (P.expr a c.env)
higherOrder c name = fail (fmt "'%' passes a pipeline to '%'; higher-order arguments are not yet supported" [c.who, name])

-- A pipeline spliced in as stages: it leaves its output, in order.
spliced r = {stages: r.stages, stream: {shape: r.output, unordered: false}}

-- Two pipeline arguments, each elaborated over the same input.
branches c what [a, b] s = map (\p -> stages c (pipelineOf p what) s) [a, b]
branches c what args s   = fail (fmt "% in '%' takes two pipelines" [what, c.who])

-- An argument as a pipeline: written out, a single application, or a name.
pipelineOf pipelineArg{elements} w  = elements
pipelineOf a@stageApp{} w           = [a]
pipelineOf a@identityPipeline{} w   = [a]
pipelineOf var{name} w              = [stageRef{name: name}]
pipelineOf a w                      = fail (fmt "% expects a process here" [w])

-- A template's body is a pipeline; its parameters are bound to the
-- arguments, a process argument as a closure over the caller's scope, a
-- value argument fitted to its type.
instantiate c k args s
  | k.pipeline == null =
      fail (fmt "'%' takes a process parameter, so it must be a pipeline definition (⇒ …)" [k.name])
  | length args != length (parameters k) =
      fail (fmt "'%' takes % arguments, given %" [k.name, length (parameters k), length args])
  | otherwise =
      let callee = foldl (bindArg c k) {env: empty, procs: noProcs} (zip (parameters k) args)
      in stages (context c.who callee.env callee.procs) k.pipeline s
parameters k = concatMap (\g -> map (\n -> {name: n, type: g.type}) g.names) k.params
bindArg c k acc [p, a]
  | P.isStream p.type =
      let closure = {elems: pipelineOf a (fmt "'%'" [k.name]), env: c.env, procs: c.procs}
      in {...acc, procs: bindProc acc.procs p.name closure}
  | otherwise =
      let value = fitted (P.expr a c.env) (P.type p.type) (fmt "argument '%' of '%' does not fit its parameter" [p.name, k.name])
      in {...acc, env: bind acc.env p.name value}
