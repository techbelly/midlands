-- The semantics of Nile kernels, as equations.
--
-- Run on numbers this is an interpreter; run on symbolic scalars it is the
-- compiler's front end (its residue is the scalar IR). The primitives come
-- from the host: D (the domain: num, bin, un, select, let, cell, branch,
-- emit, feed, state, forward), P (the program: types, operators, process
-- parameters), prim (a builtin operator on scalars), environments (empty,
-- bind, bindAll, bound, get) and a small prelude (lists). The value algebra
-- (lift, fit, leaves, tree, tuple, part, destructure, shapeOf, width) is
-- values.mooi, loaded with this file.

-- Names are bound to values, or (x') to the cells standing for one, read
-- afresh each time.
lookup ρ n = current (must (get ρ n) ("unbound name '" ++ n ++ "'"))
current b | b.cells != null = tree b.shape (map (\c -> c.get unit) b.cells)
current b                   = b
cellsOf ρ n = let b = get ρ n in if b != null && b.cells != null then b else null
bindPairs ρ pairs = foldl (\ρ [n, v] -> bind ρ n v) ρ pairs
constCell x = {get: \_ -> x, set: \_ -> unit}

scalarOf v | isScalar v = s v
scalarOf v              = fail "an `if` statement condition must be scalar (use .x/.y to pick a component)"

patternNames varPat{name}       = [name]
patternNames tuplePat{elements} = concatMap patternNames elements
patternNames _                  = []

-- Expressions denote values: trees with scalars at the leaves.
expr num{value} ρ                 = scalar (D.num value)
expr var{name} ρ                  = lookup ρ name
expr binOp{op, left, right} ρ     = apply op [expr left ρ, expr right ρ]
expr unOp{op, operand} ρ          = apply op [expr operand ρ]
expr cond{cases, otherwise} ρ     = foldr (guard ρ) (expr otherwise ρ) cases
expr tuple{elements} ρ            = tuple (map (\e -> expr e ρ) elements)
expr field{object, field} ρ       = part (expr object ρ) field
expr typed{expr: e, type: t} ρ    = fitted (expr e ρ) (P.type t) "cannot ascribe this value to its type"

-- { a if c, rest } is select(c, a, rest), lifted like any operator.
guard ρ arm rest = lift [R, R, R] (\[c, a, b] -> scalar (D.select (s c) (s a) (s b))) [expr arm.cond ρ, expr arm.value ρ, rest]

-- An operator: a builtin on scalars, or a user operator's body with the
-- arguments bound, its value of the operator's declared result type —
-- lifted over records either way.
apply op args | builtin op = lift (map (\_ -> R) args) (\xs -> scalar (prim op (map s xs))) args
apply op args              = let d = must (P.op op) ("unknown operator " ++ op)
                             in lift (map (\p -> p.shape) d.params) (\xs -> fitted (expr d.body (bindAll empty (map (\p -> p.name) d.params) xs)) d.result ("'" ++ op ++ "' does not produce its declared type")) args

-- Statements are effects; each returns the environment that follows it.
exec io decl{name, type: t, value} ρ = bind ρ name (share name (ascribe (expr value ρ) t))
exec io patAssign{pattern, value} ρ  = foldl (assignOrBind) ρ (destructure pattern (share "#pat" (expr value ρ)))
exec io assign{name, value} ρ        = assignTo ρ (name ++ "'") (expr value ρ)
exec io out{exprs} ρ                 = send D.emit io.output "a '>>' value does not fit the output type" exprs ρ
exec io in{exprs} ρ | io.flush       = fail "`<<` is not allowed in a flush body"
exec io in{exprs} ρ                  = send D.feed io.input "a '<<' value does not fit the input type" exprs ρ
exec io if{cond: c, then: t, else: f} ρ = D.branch (scalarOf (expr c ρ)) (\_ -> execs io t ρ) (\_ -> execs io (f ?? []) ρ); ρ
exec io forward{pipeline} ρ          = D.forward (map (stage ρ) pipeline); ρ

execs io stmts ρ = foldl (\ρ st -> exec io st ρ) ρ stmts

-- Each expression's value, fitted to the stream's shape, to the effect.
send effect sh msg exprs ρ = each (\e -> effect (fitLeaves (expr e ρ) sh msg)) exprs; ρ

assignOrBind ρ [n, v] | primed n = assignTo ρ n v
assignOrBind ρ [n, v]            = bind ρ n v

-- A stage of a mid-stream ⇒: its process and its arguments, fitted.
stage ρ identityPipeline{} = null
stage ρ kernelRef{name}    = {name: name, args: []}
stage ρ kernelApp{name, args} =
  let shapes = must (P.params name) ("⇒ names unknown process " ++ name)
  in {name: name, args: concat (zipWith (\a sh -> fitLeaves (expr a ρ) sh "an argument does not fit its parameter") args shapes)}

ascribe v null = v
ascribe v t    = fitted v (P.type t) "a value does not fit its declared type"

-- A value computed once, under a name: each leaf let-bound.
share n v = let ls = leaves v in tree (shapeOf v) (mapi (\x i -> D.let (leafName n i (length ls)) x) ls)
leafName n i 1 = n
leafName n i k = n ++ "#" ++ str i

-- x' = v writes the cells standing for x'.
assignTo ρ n v = let c = must (cellsOf ρ n) ("'" ++ n ++ " =' must update a state binding declared before ∀")
                 in eachi (\x i -> (at c.cells i).set x) (fitLeaves v c.shape "a value does not fit the state it updates"); ρ

-- A kernel, given its parameters bound (ρ0): state declared by its
-- prologue, a step per token, a flush.
kernel k ρ0 io =
  let layout = stateLayout k ρ0
  in { initial: concatMap (\l -> l.initial) layout
     , prologue:    \_ -> execs io (filter (\st -> not (isDecl st)) k.prologue) (phase ρ0 layout)
     , step:    \input -> step k io (phase ρ0 layout) layout input
     , flush:   \_ -> execs {...io, flush: true} k.flush (phase ρ0 layout) }

-- Prologue declarations, in order: each a state variable with its slots.
stateLayout k ρ0 = scanState ρ0 0 (filter isDecl k.prologue)
scanState ρ base []             = []
scanState ρ base [st, ...rest]  =
  let vars = declared st (ascribe (expr st.value ρ) (st.type ?? null))
  in layoutOf vars base ++ scanState (bindPairs ρ vars) (base + sumWidths vars) rest
declared decl{name} v           = [[name, v]]
declared patAssign{pattern} v   = destructure pattern v
layoutOf [] base                = []
layoutOf [[n, v], ...rest] base = [{name: n, shape: shapeOf v, base: base, initial: leaves v}] ++ layoutOf rest (base + width (shapeOf v))
sumWidths vars = sum (map (\[n, v] -> width (shapeOf v)) vars)

-- Each phase sees the params and the *current* state: rebuilt per call,
-- since on numbers D.state reads the live state.
phase ρ0 layout = foldl (\ρ l -> bind ρ l.name (tree l.shape (map (\i -> (D.state (l.base + i)).get unit) (range (width l.shape))))) ρ0 layout

-- One token. Primed state: x' is a cell starting from the pattern's x' or
-- from x, written back to x after the body.
step k io ρ layout input | length k.forAlls == 0 = if width io.input == width io.output then D.emit (leaves input) else unit
step k io ρ layout input =
  let fa     = head k.forAlls,
      ρ1     = bindPairs ρ (destructure fa.pattern input),
      ps     = primedNames fa.body,
      backs  = filter (\b -> b != null) (map (writeBack ρ1 ps) layout),
      ρ2     = foldl (\ρ b -> if b.fresh then bind ρ b.primed {cells: b.cells, shape: b.slot.shape} else ρ) ρ1 backs
  in execs io fa.body ρ2; each (\b -> eachi (\c i -> (D.state (b.slot.base + i)).set (c.get unit)) b.cells) backs

writeBack ρ ps l = writeBackAs ρ ps l (l.name ++ "'")
writeBackAs ρ ps l p | member p ps =
  let start = leaves (lookup ρ (if bound ρ p then p else l.name))
  in {slot: l, primed: p, fresh: true, cells: mapi (\x i -> D.cell (leafName p i (length start)) x) start}
writeBackAs ρ ps l p | bound ρ p = {slot: l, fresh: false, cells: map constCell (leaves (lookup ρ p))}
writeBackAs ρ ps l p = null

primedNames stmts = concatMap primedIn stmts
primedIn assign{name}       = [name ++ "'"]
primedIn patAssign{pattern} = filter primed (patternNames pattern)
primedIn if{then: t, else: f} = primedNames t ++ primedNames (f ?? [])
primedIn _                  = []

isDecl decl{}     = true
isDecl patAssign{} = true
isDecl _          = false
