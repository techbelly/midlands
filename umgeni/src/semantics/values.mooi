-- The value algebra: Nile values are trees with scalars at the leaves; a
-- shape is a tree's skeleton. Operators are defined on scalars and lifted:
-- a scalar broadcasts against a record, records of one shape zip.

scalar x       = {k: "scalar", expr: x}
agg sh parts   = {k: "agg", shape: sh, parts: parts}
s v            = v.expr

width real{}         = 1
width record{fields} = sum (map (\f -> width f.shape) fields)

shapeOf scalar{}     = R
shapeOf agg{shape}   = shape

leaves scalar{expr}  = [expr]
leaves agg{parts}    = concatMap leaves parts

-- The tree of a shape whose leaves are xs, in order.
tree real{} xs          = scalar (head xs)
tree sh xs              = agg sh (chunks sh.fields xs)
chunks [] xs            = []
chunks [f, ...fs] xs    = [tree f.shape (take (width f.shape) xs)] ++ chunks fs (drop (width f.shape) xs)

tuple parts = agg {k: "record", name: null, fields: map (\p -> {name: null, shape: shapeOf p}) parts} parts

-- A scalar fills any shape; a record fits a shape of the same arity, field
-- by field. (null: it does not fit.)
fit v@scalar{} real{} = v
fit v@scalar{} sh     = agg sh (map (\f -> fit v f.shape) sh.fields)
fit v real{}          = null
fit v sh
  | length v.parts != length sh.fields = null
  | otherwise = let fs = zipWith (\p f -> fit p f.shape) v.parts sh.fields
                in if all (\x -> x != null) fs then agg sh fs else null

-- A value fitted to a shape, or the failure named; and its leaves.
fitted v sh msg   = must (fit v sh) msg
fitLeaves v sh msg = leaves (fitted v sh msg)

-- Apply f to arguments fitted to its parameter shapes, or — when some
-- argument is a bigger record — componentwise over that record's shape.
lift shapes f args =
  let fs = zipWith fit args shapes
  in if all (\x -> x != null) fs then f fs else liftOver shapes f args fs

-- The arguments that did not fit (the misfits) must share one record
-- shape; component i of the result applies f with each misfit replaced
-- by its component i.
liftOver shapes f args fs =
  let misfits = compact (zipWith (\a x -> if x == null then a else null) args fs),
      sh      = liftShape misfits,
      argsAt  = \i -> zipWith (\a x -> if x == null then component a i else a) args fs
  in agg sh (map (\i -> lift shapes f (argsAt i)) (indices sh.fields))

liftShape [scalar{}, ...rest] = fail "operator argument does not fit its parameter"
liftShape [a, ...rest]
  | any (\b -> not (sameShape (shapeOf b) a.shape)) rest = fail "cannot lift an operator across different record shapes"
  | otherwise                                            = a.shape

component v@scalar{} i = v
component v i          = at v.parts i

sameShape real{} real{}                       = true
sameShape record{fields: a} record{fields: b} = length a == length b && all id (zipWith (\x y -> sameShape x.shape y.shape) a b)
sameShape _ _                                 = false

part scalar{} f = fail (fmt "field '.%' on a scalar" [f])
part v f
  | fieldIndex v f == null = fail (fmt "no field '.%'" [f])
  | otherwise              = at v.parts (fieldIndex v f)
fieldIndex v f = indexOf f (map (\x -> x.name) v.shape.fields)

-- Take a value apart by a (possibly nested) tuple pattern.
destructure varPat{name} v        = [[name, v]]
destructure wildcardPat{} v       = []
destructure tuplePat{} scalar{}   = fail "cannot destructure a Real"
destructure tuplePat{elements} v
  | length elements != length v.parts = fail "pattern binds the wrong number of components"
  | otherwise                         = concat (zipWith destructure elements v.parts)
